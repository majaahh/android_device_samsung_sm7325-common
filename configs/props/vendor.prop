# Audio
aaudio.hw_burst_min_usec=2000
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
persist.vendor.audio.ambisonic.auto.profile=0
persist.vendor.audio.ambisonic.capture=0
persist.vendor.audio.apptype.multirec.enabled=0
persist.vendor.audio.avs.afe_api_version=9
persist.vendor.audio.bcl.enabled=1
persist.vendor.audio.fluence.speaker=1
persist.vendor.audio.fluence.tmic.enabled=0
persist.vendor.audio.fluence.voicecall=1
persist.vendor.audio.fluence.voicecomm=1
persist.vendor.audio.fluence.voicerec=0
persist.vendor.audio.ha_proxy.enabled=1
persist.vendor.audio.ras.enabled=0
persist.vendor.audio.speaker.prot.enable=1
persist.vendor.audio.spv4.enable=1
persist.vendor.audio.vbat.enabled=1
persist.vendor.audio.voicecall.speaker.stereo=1
ro.config.vc_call_vol_steps=8
ro.vendor.audio.sdk.fluencetype=none
ro.vendor.audio.sdk.ssr=0
vendor.audio.adm.buffering.ms=3
vendor.audio.dolby.ds2.enabled=0
vendor.audio.dolby.ds2.hardbypass=0
vendor.audio.enable.mirrorlink=0
vendor.audio.feature.a2dp_offload.enable=1
vendor.audio.feature.audiozoom.enable=0
vendor.audio.feature.compr_voip.enable=1
vendor.audio.feature.compress_meta_data.enable=1
vendor.audio.feature.concurrent_capture.enable=0
vendor.audio.feature.deepbuffer_as_primary.enable=1
vendor.audio.feature.display_port.enable=1
vendor.audio.feature.external_dsp.enable=0
vendor.audio.feature.external_speaker.enable=0
vendor.audio.feature.fm.enable=1
vendor.audio.feature.hdmi_edid.enable=1
vendor.audio.feature.hfp.enable=1
vendor.audio.feature.hwdep_cal.enable=0
vendor.audio.feature.incall_music.enable=1
vendor.audio.feature.maxx_audio.enable=0
vendor.audio.feature.multi_voice_session.enable=0
vendor.audio.feature.snd_mon.enable=1
vendor.audio.feature.spkr_prot.enable=1
vendor.audio.feature.usb_offload.enable=1
vendor.audio.hal.boot.timeout.ms=20000
vendor.audio.hal.output.suspend.supported=1
vendor.audio.hw.aac.encoder=1
vendor.audio.offload.buffer.size.kb=32
vendor.audio.offload.gapless.enabled=1
vendor.audio.offload.multiaac.enable=1
vendor.audio.offload.multiple.enabled=0
vendor.audio.offload.passthrough=0
vendor.audio.offload.track.enable=1
vendor.audio.parser.ip.buffer.size=262144
vendor.audio.safx.pbe.enabled=0
vendor.audio.spkr_prot.tx.sampling_rate=48000
vendor.audio.tunnel.encode=0
vendor.audio.use.sw.alac.decoder=1
vendor.audio.use.sw.ape.decoder=1
vendor.audio.use.sw.mpegh.decoder=1
vendor.audio.volume.headset.gain.depcal=1
vendor.audio_hal.in_period_size=144
vendor.audio_hal.period_multiplier=4
vendor.audio_hal.period_size=192
vendor.voice.path.for.pcm.voip=1

# Bluetooth
persist.bluetooth.a2dp_offload.disabled=0
persist.vendor.bt.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac
persist.vendor.bt.aac_frm_ctl.enabled=1
persist.vendor.bt.aac_vbr_frm_ctl.enabled=1
ro.bluetooth.a2dp_offload.supported=1
vendor.qcom.bluetooth.soc=moselle

# Camera
camera.disable_zsl_mode=1
ro.camera.notify_nfc=1

# Chipset
ro.soc.manufacturer=QTI
ro.soc.model=SM7325

# Crypto
ro.crypto.metadata_init_delete_all_keys.enabled=0
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.dm_default_key.options_format.version=2
ro.crypto.volume.metadata.method=dm-default-key

# Dalvik VM
dalvik.vm.lockprof.threshold=500

# Display
debug.sf.auto_latch_unsignaled=0
debug.sf.disable_backpressure=1
debug.sf.enable_advanced_sf_phase_offset=1
debug.sf.enable_gl_backpressure=1
debug.sf.high_fps_early_gl_phase_offset_ns=-4000000
debug.sf.high_fps_early_phase_offset_ns=-4000000
debug.sf.high_fps_late_app_phase_offset_ns=1000000
debug.sf.high_fps_late_sf_phase_offset_ns=-4000000
debug.sf.latch_unsignaled=1
persist.sys.sf.color_saturation=1.0
persist.sys.sf.hs_mode=0
ro.gfx.driver.1=com.qualcomm.qti.gpudrivers.lahaina.api30
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno
ro.opengles.version=196610
ro.surface_flinger.enable_frame_rate_override=0
ro.surface_flinger.force_hwc_copy_for_virtual_displays=1
ro.surface_flinger.has_HDR_display=1
ro.surface_flinger.has_wide_color_display=1
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.max_virtual_display_dimension=4096
ro.surface_flinger.protected_contents=1
ro.surface_flinger.supports_background_blur=1
ro.surface_flinger.use_color_management=1
ro.surface_flinger.use_content_detection_for_refresh_rate=0
ro.surface_flinger.wcg_composition_dataspace=143261696
vendor.display.comp_mask=0
vendor.display.disable_dynamic_fps=1
vendor.display.disable_excl_rect=0
vendor.display.disable_excl_rect_partial_fb=1
vendor.display.disable_ext_anim=1
vendor.display.disable_hw_recovery_dump=1
vendor.display.disable_offline_rotator=1
vendor.display.disable_scaler=0
vendor.display.enable_async_powermode=0
vendor.display.enable_early_wakeup=0
vendor.display.enable_optimize_refresh=1
vendor.display.idle_time=0
vendor.display.idle_time_inactive=0
vendor.display.use_smooth_motion=1
vendor.gralloc.disable_ubwc=0

# Fingerprint
ro.vendor.fingerprint.max_enrollments=3

# Gatekeeper
ro.hardware.gatekeeper=mdfpp

# Keystore
ro.hardware.keystore=mdfpp
ro.security.keystore.keytype=sakv2,gak

# Media
debug.stagefright.c2inputsurface=-1

# Netflix
ro.netflix.bsp_rev=Q7325-SPY-33758-1

# Perf
ro.vendor.extension_library=libqti-perfd-client.so

# Power HAL
vendor.powerhal.disp.idle_support=0

# RIL
persist.vendor.radio.atfwd.start=1
persist.vendor.radio.enableadvancedscan=1
ro.radio.noril=no
ro.telephony.default_cdma_sub=0
ro.vendor.sec.radio.def_network=9
ro.vendor.use_data_netmgrd=0
vendor.sec.rild.libpath=/vendor/lib64/libsec-ril.so

# USB
sys.usb.mtp.batchcancel=1
vendor.usb.diag.func.name=ffs
vendor.usb.dpl.inst.name=dpl
vendor.usb.qdss.inst.name=qdss_sw
vendor.usb.rmnet.func.name=gsi
vendor.usb.rmnet.inst.name=rmnet
vendor.usb.rndis.func.name=gsi
vendor.usb.use_ffs_mtp=1
vendor.usb.use_gadget_hal=0

# Vibrator
ro.vendor.vibrator_hal.click_duration=80
ro.vendor.vibrator_hal.tick_duration=40

# Wi-Fi
wifi.aware.interface=wifi-aware0
